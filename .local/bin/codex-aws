#!/usr/bin/env bash
set -euo pipefail

PROFILE="${CODEX_AWS_PROFILE:-default}"

if [[ $# -gt 0 && "${1:-}" != "--" ]]; then
  PROFILE="$1"
  shift
fi
if [[ "${1:-}" == "--" ]]; then
  shift
fi

command -v aws >/dev/null 2>&1 || {
  echo "error: aws CLI not found in PATH" >&2
  exit 127
}
CODEX_BIN="$(command -v codex || true)"
if [[ -z "$CODEX_BIN" ]]; then
  echo "error: codex command not found in PATH" >&2
  exit 127
fi

PROFILE_FILE="${CODEX_HOME:-$HOME/.codex}/aws.config.toml"
if [[ ! -r "$PROFILE_FILE" ]]; then
  echo "error: $PROFILE_FILE not found or not readable" >&2
  exit 1
fi

# Do not accidentally carry GitHub credentials into an AWS-only session.
unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN 2>/dev/null || true

# Remove pre-existing AWS credential sources before loading the chosen profile.
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN 2>/dev/null || true
unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_SHARED_CREDENTIALS_FILE AWS_CONFIG_FILE 2>/dev/null || true
unset AWS_WEB_IDENTITY_TOKEN_FILE AWS_ROLE_ARN AWS_ROLE_SESSION_NAME 2>/dev/null || true
unset AWS_CONTAINER_CREDENTIALS_RELATIVE_URI AWS_CONTAINER_CREDENTIALS_FULL_URI 2>/dev/null || true
unset AWS_CONTAINER_AUTHORIZATION_TOKEN AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE 2>/dev/null || true

# Resolve credentials OUTSIDE Codex. AWS CLI may source these from SSO,
# AssumeRole, login credentials, credential_process, or a credentials file.
if ! CREDENTIAL_EXPORTS="$(aws configure export-credentials --profile "$PROFILE" --format env)"; then
  echo "error: could not export credentials for AWS profile '$PROFILE'." >&2
  echo "If this is an SSO profile, run: aws sso login --profile '$PROFILE'" >&2
  exit 1
fi

# Output is generated by the trusted AWS CLI in shell export format.
eval "$CREDENTIAL_EXPORTS"
unset CREDENTIAL_EXPORTS

# Export region separately so sandboxed AWS commands do not need ~/.aws/config.
REGION="$(aws configure get region --profile "$PROFILE" 2>/dev/null || true)"
if [[ -n "$REGION" ]]; then
  export AWS_REGION="$REGION"
  export AWS_DEFAULT_REGION="$REGION"
fi
unset REGION

# Avoid making the profile name a second credential/config lookup path inside Codex.
unset AWS_PROFILE AWS_DEFAULT_PROFILE

exec "$CODEX_BIN" --profile aws "$@"
